{
  "name": "kaying-for-tuanjie",
  "version": "0.1.0",
  "description": "Tuanjie Engine (团结引擎) game-development skills for coding agents — Pi port of Unity's official agent plugin adapted for Tuanjie: editor-binary automation, packages.unity.cn registry, WeChat Mini Game and China-market guidance.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "keywords": [
    "pi-package",
    "tuanjie",
    "团结引擎",
    "unity-china",
    "gamedev",
    "game-development",
    "wechat-minigame",
    "openharmony",
    "urp",
    "tilemap",
    "in-app-purchases",
    "localization",
    "workbuddy-plugin",
    "codebuddy-plugin"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/tuanjie.ts"
    ]
  },
  "scripts": {
    "build:workbuddy": "node scripts/build-workbuddy.mjs",
    "check:workbuddy": "node scripts/build-workbuddy.mjs --check",
    "build:plugins": "node scripts/sync-plugin-skills.mjs",
    "check:plugins": "node scripts/sync-plugin-skills.mjs --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "skills",
    "extensions",
    "for-claude",
    "for-codex",
    "for-pi",
    "for-zcode",
    "for-kayingcode",
    "for-workbuddy",
    "scripts/build-workbuddy.mjs",
    "scripts/sync-plugin-skills.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE.md"
  ]
}
